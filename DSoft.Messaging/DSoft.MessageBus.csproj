<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>netstandard2.1;net8.0;net10.0;net10.0-ios;net10.0-macos;net10.0-maccatalyst;net10.0-tvos;net10.0-android;</TargetFrameworks>
		<TargetFrameworks Condition=" '$(OS)' == 'Windows_NT' ">$(TargetFrameworks);net472;net8.0-windows7.0;net10.0-windows7.0;net10.0-windows10.0.19041;</TargetFrameworks>
		<PackageId>DSoft.MessageBus</PackageId>
		<AssemblyName>DSoft.MessageBus</AssemblyName>
		<Company>DSoft Developments</Company>
		<Product>$(AssemblyName) ($(TargetFramework))</Product>
		<Title>DSoft.MessageBus</Title>
		<Description>MessageBus is a cross platform EventBus system similar to NSNoticationCenter on iOS and otto on Android</Description>
		<Copyright>© DSoft Developments. All rights reserved.</Copyright>
		<ConsolePause>false</ConsolePause>
		<PackageTags>MessageBus</PackageTags>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<DefineConstants>$(DefineConstants);</DefineConstants>
		<Configurations>Debug;Release;</Configurations>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>DSIcon.png</PackageIcon>
		<EnablePreviewMsixTooling>true</EnablePreviewMsixTooling>
		<GenerateLibraryLayout>true</GenerateLibraryLayout>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">14.2</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'macos'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tvos'">14.0</SupportedOSPlatformVersion>
		<NoWarn>$(NoWarn);NETSDK1206;CA1416;</NoWarn>
		<PackageReleaseNotes>Updated to .NET 10 and latest dependencies
			Removed .NET 9 targets (.NET 8 and .NET 10 LTS remain supported)
		</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<None Include="../README.md" Pack="true" PackagePath="\" />
		<None Include="..\DSIcon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
	
	<PropertyGroup Condition=" $(TargetFramework.Contains('windows10')) ">
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<UseWinUI>true</UseWinUI>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<RuntimeIdentifiers>win-x86;win-x64;win-arm64;</RuntimeIdentifiers>
		<DefineConstants>$(DefineConstants);WINUI</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)'=='Debug' ">
		<DebugSymbols>true</DebugSymbols>
	</PropertyGroup>

	<PropertyGroup Condition=" $(TargetFramework.Contains('windows7.0')) ">
		<UseWPF>true</UseWPF>
	</PropertyGroup>
	
	<ItemGroup>
		<Compile Include="**\*.shared.cs" />
		<Compile Include="**\*.shared.*.cs" />
	</ItemGroup>

	<ItemGroup Condition=" $(TargetFramework.StartsWith('netstandard')) Or $(TargetFramework) == 'net8.0' Or $(TargetFramework) == 'net10.0' Or $(TargetFramework) == 'net472'">
		<Compile Include="**\*.netstandard.cs" />
		<Compile Include="**\*.netstandard.*.cs" />
	</ItemGroup>

	<ItemGroup Condition=" $(TargetFramework.Contains('windows7.0')) ">
		<Compile Include="**\*.wpf.cs" />
		<Compile Include="**\*.wpf.*.cs" />
	</ItemGroup>

	<ItemGroup Condition=" $(TargetFramework.Contains('windows10')) ">
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
		<PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />

		<Compile Include="**\*.winui.cs" />
		<Compile Include="**\*.winui.*.cs" />

	</ItemGroup>

	<ItemGroup Condition=" $(TargetFramework.Contains('android')) ">
		<Compile Include="**\*.android.cs" />
		<Compile Include="**\*.android.*.cs" />
	</ItemGroup>

	<ItemGroup Condition=" $(TargetFramework.Contains('ios')) Or $(TargetFramework.Contains('maccatalyst')) ">
		<Compile Include="**\*.ios.cs" />
		<Compile Include="**\*.ios.*.cs" />
	</ItemGroup>

	<ItemGroup Condition=" $(TargetFramework.Contains('macos')) ">
		<Compile Include="**\*.mac.cs" />
		<Compile Include="**\*.mac.*.cs" />
	</ItemGroup>

	<ItemGroup Condition="  $(TargetFramework.Contains('tvos')) ">
		<Compile Include="**\*.tvos.cs" />
		<Compile Include="**\*.tvos.*.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
	</ItemGroup>	 

	<ItemGroup>
	  <ProjectReference Include="..\DSoft.MessageBus.Core\DSoft.MessageBus.Core.csproj" />
	</ItemGroup>

</Project>